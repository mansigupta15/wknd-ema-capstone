{
  "templates": [
    {
      "name": "home",
      "urls": [
        "https://wknd.site/us/en.html"
      ],
      "representativeUrl": "https://wknd.site/us/en.html",
      "description": "WKND homepage: hero carousel, featured article, article/adventure card grids and a hero teaser",
      "blocks": [
        {
          "name": "carousel-hero",
          "instances": [
            ".carousel.cmp-carousel--hero"
          ]
        },
        {
          "name": "columns-featured",
          "instances": [
            ".teaser.cmp-teaser--featured"
          ]
        },
        {
          "name": "cards-article",
          "instances": [
            ".image-list.list"
          ]
        },
        {
          "name": "hero-teaser",
          "instances": [
            ".teaser.cmp-teaser--hero.cmp-teaser--imagebottom"
          ]
        }
      ],
      "urlPattern": "/us/*",
      "sections": [
        {
          "id": "section-1",
          "name": "hero-carousel",
          "selector": [
            ".carousel.cmp-carousel--hero"
          ],
          "style": null,
          "blocks": [
            "carousel-hero"
          ],
          "defaultContent": []
        },
        {
          "id": "section-2",
          "name": "featured-article",
          "selector": [
            ".teaser.cmp-teaser--featured"
          ],
          "style": null,
          "blocks": [
            "columns-featured"
          ],
          "defaultContent": []
        },
        {
          "id": "section-3",
          "name": "recent-articles",
          "selector": [
            ".teaser.cmp-teaser--featured + .title.cmp-title--underline"
          ],
          "style": null,
          "blocks": [
            "cards-article"
          ],
          "defaultContent": [
            ".teaser.cmp-teaser--featured + .title.cmp-title--underline",
            ".teaser.cmp-teaser--featured ~ .button.cmp-button--primary"
          ]
        },
        {
          "id": "section-4",
          "name": "next-adventures",
          "selector": [
            ".cmp-layout-container--fixed .separator + .title.cmp-title--underline"
          ],
          "style": null,
          "blocks": [
            "hero-teaser"
          ],
          "defaultContent": [
            ".cmp-layout-container--fixed .separator + .title.cmp-title--underline"
          ]
        },
        {
          "id": "section-5",
          "name": "where-to-go",
          "selector": [
            ".teaser.cmp-teaser--hero + .cmp-layout-container--fixed"
          ],
          "style": null,
          "blocks": [
            "cards-article"
          ],
          "defaultContent": [
            ".teaser.cmp-teaser--hero + .cmp-layout-container--fixed .title",
            ".teaser.cmp-teaser--hero + .cmp-layout-container--fixed .button.cmp-button--primary"
          ]
        }
      ]
    },
    {
      "name": "magazine",
      "urls": [
        "https://wknd.site/us/en/magazine.html"
      ],
      "representativeUrl": "https://wknd.site/us/en/magazine.html",
      "description": "WKND magazine listing: page title + featured article, article card grid, members-only locked teasers",
      "urlPattern": "/us/en/magazine",
      "blocks": [
        {
          "name": "columns-featured",
          "instances": [
            ".teaser.cmp-teaser--featured"
          ]
        },
        {
          "name": "cards-article",
          "instances": [
            ".image-list.list",
            ".teaser.cmp-teaser--secure"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "page-title-featured",
          "selector": [
            "main .title:not(.cmp-title--underline)"
          ],
          "style": null,
          "blocks": [
            "columns-featured"
          ],
          "defaultContent": [
            "main .title:not(.cmp-title--underline)"
          ]
        },
        {
          "id": "section-2",
          "name": "all-articles",
          "selector": [
            ".teaser.cmp-teaser--featured + .title.cmp-title--underline"
          ],
          "style": null,
          "blocks": [
            "cards-article"
          ],
          "defaultContent": [
            ".teaser.cmp-teaser--featured + .title.cmp-title--underline"
          ]
        },
        {
          "id": "section-3",
          "name": "members-only",
          "selector": [
            ".image-list.list + .title.cmp-title--underline"
          ],
          "style": "divider",
          "blocks": [],
          "defaultContent": [
            ".image-list.list + .title.cmp-title--underline",
            ".image-list.list + .title.cmp-title--underline + .text"
          ]
        },
        {
          "id": "section-4",
          "name": "members-only-teasers",
          "selector": [
            ".separator.cmp-separator--space-medium + .teaser.cmp-teaser--secure"
          ],
          "style": null,
          "blocks": [
            "cards-article"
          ],
          "defaultContent": []
        }
      ]
    },
    {
      "name": "article",
      "urls": [
        "https://wknd.site/us/en/magazine/western-australia.html"
      ],
      "representativeUrl": "https://wknd.site/us/en/magazine/western-australia.html",
      "description": "WKND magazine article: hero image, title + byline + content-fragment body with quote, author card, up-next sidebar",
      "urlPattern": "/us/en/magazine/*",
      "metadata": {
        "Template": "article"
      },
      "blocks": [
        {
          "name": "columns-author",
          "instances": [
            ".byline"
          ]
        },
        {
          "name": "cards-related",
          "instances": [
            ".cmp-list--upnext"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "hero",
          "selector": [
            "main > .cmp-container > .aem-Grid > .image"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            "main > .cmp-container > .aem-Grid > .image"
          ]
        },
        {
          "id": "section-2",
          "name": "article-body",
          "selector": [
            "main main"
          ],
          "style": null,
          "blocks": [
            "columns-author"
          ],
          "defaultContent": [
            "main main .title",
            "main main .contentfragment"
          ]
        },
        {
          "id": "section-3",
          "name": "sidebar",
          "selector": [
            "aside.cmp-layoutcontainer--sidebar"
          ],
          "style": "sidebar",
          "blocks": [
            "cards-related"
          ],
          "defaultContent": [
            "aside .title.cmp-title--black"
          ]
        }
      ]
    },
    {
      "name": "adventure",
      "urls": [
        "https://wknd.site/us/en/adventures/climbing-new-zealand.html",
        "https://wknd.site/us/en/adventures/downhill-skiing-wyoming.html",
        "https://wknd.site/us/en/adventures/tahoe-skiing.html",
        "https://wknd.site/us/en/adventures/west-coast-cycling.html",
        "https://wknd.site/us/en/adventures/whistler-mountain-biking.html",
        "https://wknd.site/us/en/adventures/yosemite-backpacking.html"
      ],
      "representativeUrl": "https://wknd.site/us/en/adventures/climbing-new-zealand.html",
      "description": "WKND adventure detail: image slider, title, facts sidebar (activity, length, price...), Overview / Itinerary / What to Bring tabs",
      "urlPattern": "/us/en/adventures/*",
      "metadata": {
        "Template": "adventure"
      },
      "blocks": [
        {
          "name": "carousel-hero",
          "instances": [
            ".carousel.cmp-carousel--mini"
          ]
        },
        {
          "name": "cards-related",
          "instances": [
            ".contentfragment.cmp-contentfragment--elements"
          ]
        },
        {
          "name": "tabs",
          "instances": [
            ".tabs.panelcontainer"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "slider",
          "selector": [
            ".carousel.cmp-carousel--mini"
          ],
          "style": null,
          "blocks": [
            "carousel-hero"
          ],
          "defaultContent": []
        },
        {
          "id": "section-2",
          "name": "title",
          "selector": [
            ".cmp-layout-container--fixed .title.cmp-title--underline"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            ".title.cmp-title--underline"
          ]
        },
        {
          "id": "section-3",
          "name": "sidebar",
          "selector": [
            "main[class*=\"aem-GridColumn--default--3\"]"
          ],
          "style": "sidebar",
          "blocks": [
            "cards-related"
          ],
          "defaultContent": [
            "main[class*=\"aem-GridColumn--default--3\"] .title"
          ]
        },
        {
          "id": "section-4",
          "name": "details",
          "selector": [
            ".tabs.panelcontainer"
          ],
          "style": null,
          "blocks": [
            "tabs"
          ],
          "defaultContent": []
        }
      ]
    },
    {
      "name": "adventure-listing",
      "urls": [
        "https://wknd.site/us/en/adventures.html"
      ],
      "representativeUrl": "https://wknd.site/us/en/adventures.html",
      "description": "WKND adventures listing: title, hero teaser, \"Current Adventures\" cards filterable by category",
      "urlPattern": "/us/en/adventures",
      "metadata": {
        "Template": "adventure-listing"
      },
      "blocks": [
        {
          "name": "hero-teaser",
          "instances": [
            ".teaser.cmp-teaser--hero"
          ]
        },
        {
          "name": "cards-article",
          "instances": [
            ".tabs.panelcontainer"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "title",
          "selector": [
            ".cmp-layout-container--fixed .title:not(.cmp-title--underline)"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            ".title"
          ]
        },
        {
          "id": "section-2",
          "name": "hero",
          "selector": [
            ".teaser.cmp-teaser--hero"
          ],
          "style": null,
          "blocks": [
            "hero-teaser"
          ],
          "defaultContent": []
        },
        {
          "id": "section-3",
          "name": "current-adventures",
          "selector": [
            ".cmp-layout-container--fixed .title.cmp-title--underline"
          ],
          "style": "divider",
          "blocks": [
            "cards-article"
          ],
          "defaultContent": [
            ".title.cmp-title--underline"
          ]
        }
      ]
    }
  ],
  "metadata": {
    "projectType": "da"
  }
}
